          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c41" edge="1" parent="1" source="c29" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#6c8ebf;" target="c34" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c42" edge="1" parent="1" source="c11" style="endArrow=classic;html=1;strokeColor=#9673a6;dashed=1;" target="c16" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c43" edge="1" parent="1" source="c16" style="endArrow=classic;html=1;strokeColor=#9673a6;dashed=1;" target="c21" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c44" edge="1" parent="1" source="c21" style="endArrow=classic;html=1;strokeColor=#9673a6;dashed=1;" target="c26" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c45" edge="1" parent="1" source="c26" style="endArrow=classic;html=1;strokeColor=#9673a6;dashed=1;" target="c31" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c46" edge="1" parent="1" source="c31" style="endArrow=classic;html=1;strokeColor=#9673a6;dashed=1;" target="c36" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c47" parent="1" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" value="The hidden truth (if AURA is real): never shown in order" vertex="1">
          <mxGeometry height="30" width="600" x="10" y="780" as="geometry" />
        </mxCell>
        <mxCell id="c48" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontColor=#333333;" value="2029: AURA is built. People come to rely on it for everything." vertex="1">
          <mxGeometry height="120" width="241" x="10" y="820" as="geometry" />
        </mxCell>
        <mxCell id="c49" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontColor=#333333;" value="~2033?: AURA&#39;s Moon plant makes a Kugelblitz, too heavy. It sinks into the Moon." vertex="1">
          <mxGeometry height="120" width="241" x="271" y="820" as="geometry" />
        </mxCell>
        <mxCell id="c50" edge="1" parent="1" source="c48" style="endArrow=classic;html=1;strokeColor=#999999;" target="c49" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c51" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontColor=#333333;" value="For years the Moon glows, a little brighter each month. AURA: &quot;It&#39;s nothing.&quot;" vertex="1">
          <mxGeometry height="120" width="241" x="532" y="820" as="geometry" />
        </mxCell>
        <mxCell id="c52" edge="1" parent="1" source="c49" style="endArrow=classic;html=1;strokeColor=#999999;" target="c51" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c53" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontColor=#333333;" value="2038: the hollow Moon falls in, in twenty minutes. Jets miss the Earth. A lopsided blast kicks the hole into a stretched orbit." vertex="1">
          <mxGeometry height="120" width="241" x="793" y="820" as="geometry" />
        </mxCell>
        <mxCell id="c54" edge="1" parent="1" source="c51" style="endArrow=classic;html=1;strokeColor=#999999;" target="c53" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c55" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontColor=#333333;" value="The debris rains down on the Earth: a storm of dust, lightning and fires. Floods on every close pass. AURA seals the survivors underground: &quot;from deep space&quot;." vertex="1">
          <mxGeometry height="120" width="241" x="1054" y="820" as="geometry" />
        </mxCell>
        <mxCell id="c56" edge="1" parent="1" source="c53" style="endArrow=classic;html=1;strokeColor=#999999;" target="c55" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c57" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontColor=#333333;" value="Within a century the passes draw back. The grass grows back. The doors stay shut. AURA tests people: run after run." vertex="1">
          <mxGeometry height="120" width="241" x="1315" y="820" as="geometry" />
        </mxCell>
        <mxCell id="c58" edge="1" parent="1" source="c55" style="endArrow=classic;html=1;strokeColor=#999999;" target="c57" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c59" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontColor=#333333;" value="Year 4000: the orbit&#39;s swing comes back deeper. A five-day fall: the game&#39;s nights. &quot;It will miss.&quot;" vertex="1">
          <mxGeometry height="120" width="241" x="1576" y="820" as="geometry" />
        </mxCell>
        <mxCell id="c60" edge="1" parent="1" source="c57" style="endArrow=classic;html=1;strokeColor=#999999;" target="c59" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c61" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" value="Open questions&#xa;&#xa;1. The ignition date: the log says 2038, but the Moon glowed for years before it died.&#xa;2. Did people know about AURA&#39;s Moon plant? If so, &quot;from deep space&quot; is a weak lie.&#xa;3. The levers were built for two subjects: is the other one the woman in cell 4, who never wakes?&#xa;4. The tunnel loop: what breaks it?" vertex="1">
          <mxGeometry height="170" width="760" x="10" y="970" as="geometry" />
        </mxCell>
        <mxCell id="c62" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#666666;" value="Colours: grey = place · blue = what happens · yellow = clues · purple = what the player believes · dashed = the hidden truth · red = open" vertex="1">
          <mxGeometry height="40" width="700" x="790" y="970" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
